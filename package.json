{
  "name": "jev-decision-wall",
  "version": "1.2.0",
  "description": "Type anything. 200 yes/no judgments light up in ~250 ms from one parallel call to TypeSafe Jev, with an Explain view that shows which words drive each answer.",
  "main": "server.js",
  "bin": {
    "jev-decision-wall": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/server.test.js test/frontend.test.js",
    "check": "node scripts/check-sets.js && node --test test/server.test.js test/frontend.test.js",
    "record": "node scripts/record-replays.js",
    "pages": "node scripts/build-pages.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "ai",
    "classification",
    "heatmap",
    "parallel",
    "system-one",
    "demo"
  ],
  "author": "Charles Forsyth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/charles-forsyth/jev-decision-wall.git"
  },
  "homepage": "https://charles-forsyth.github.io/jev-decision-wall/"
}
