# Copy to .env and fill in. .env is git-ignored; never commit it.
# Get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Optional
# PORT=8770
# HOST=127.0.0.1                 # keep localhost unless you add sign-in (AUTH_HEADER)
# JEV_DAILY_TOKEN_CAP=5000000    # all users, input tokens per day (~$0.21 at $0.042 per million)
# JEV_USER_DAILY_TOKEN_CAP=1000000
# JEV_USAGE_FILE=~/.config/jev/usage.jsonl
# AUTH_HEADER=x-goog-authenticated-user-email   # set when behind Google IAP
# ALLOWED_DOMAIN=example.edu
# NOTICE=Use made-up or public text.
